  "experiments": [
    {
      "id": "01",
      "title": "당첨게임 수의 분포",
      "question": "원당첨게임 수가 얼마나 불균형한가?",
      "formula": "K = 당첨게임 수",
      "note": "판매량 차이가 포함된다. 단독 이상 판정에는 쓰지 않는다.",
      "normalization": "등수별 Z점수"
    },
    {
      "id": "02",
      "title": "판매량 대비 관측·기대 비율",
      "question": "판매량을 나누어도 큰 편차가 남는가?",
      "formula": "R = K / (N × p)",
      "note": "이론 기준은 1이다. 큰 비율이 곧 작은 p값을 뜻하지 않는다.",
      "normalization": "등수별 Z점수"
    },
    {
      "id": "03",
      "title": "이항분산 기준 편차",
      "question": "독립 이항모형으로 설명되지 않는 변동은 얼마나 큰가?",
      "formula": "e = (K − Np) / sqrt(Np(1−p))",
      "note": "양측 이중 꼬리확률과 BH/BY를 계산한다. 독립 게임 가정이 맞지 않아 확정 유의성에 사용하지 않는다.",
      "normalization": "등수별 Z점수"
    },
    {
      "id": "04",
      "title": "로그 비율의 비대칭",
      "question": "상승과 하락을 로그 척도에서 비교하면 어떻게 보이는가?",
      "formula": "L = log((K + 0.5) / (Np + 0.5))",
      "note": "0.5는 K=0의 로그를 계산하기 위한 명시적 연속성 보정이다. 원값을 대체하지 않는다.",
      "normalization": "등수별 Z점수"
    },
    {
      "id": "05",
      "title": "제도 구간의 수준 효과",
      "question": "1~87, 88~400, 401회 이후의 수준 차이를 제거하면 무엇이 남는가?",
      "formula": "L − 해당 등수·기간의 L 평균",
      "note": "같은 자료로 중심을 추정한 기술적 잔차다. 기간 내 평균 0은 계산 결과의 구조이지 발견이 아니다.",
      "normalization": "등수별 Z점수"
    },
    {
      "id": "06",
      "title": "판매규모의 수준 효과",
      "question": "판매량 사분위별 중심을 제거해도 편차가 남는가?",
      "formula": "L − 해당 등수·판매사분위의 L 중앙값",
      "note": "사분위 경계는 회차별 판매량으로 한 번만 계산해 세 등수에 공유한다. 시간과 판매량의 인과 효과를 구분하지 않는다.",
      "normalization": "등수별 Z점수"
    },
    {
      "id": "07",
      "title": "직전 회차 대비 급변",
      "question": "높은 수준이 이어지는가, 한 번에 튀는가?",
      "formula": "R(t) − R(t−1), 동일 제도 구간만",
      "note": "1·88·401회는 직전 구간과 연결하지 않는다. 큰 차이를 자료 오류로 간주하지 않는다.",
      "normalization": "등수별 Z점수"
    },
    {
      "id": "08",
      "title": "25회 비중복 누적 비율",
      "question": "25회씩 합쳐도 편차가 남는가?",
      "formula": "sum(K) / sum(Np), 구간별 25회 블록",
      "note": "이동창의 중복을 피한다. 각 기간 마지막 25회 미만 묶음은 이 분석에만 사용하지 않고 별도 기록한다.",
      "normalization": "등수별 Z점수"
    },
    {
      "id": "09",
      "title": "극단값에 강건한 표준화",
      "question": "극단값이 평균·표준편차를 키워 다른 편차를 가리는가?",
      "formula": "(L − median(L)) / (1.4826 × MAD(L))",
      "note": "04와 같은 값의 척도 민감도 분석이다. 별개의 독립 증거가 아니다. ±3은 표시 기준이며 유의성 검정이 아니다.",
      "normalization": "등수별 중앙값/MAD"
    },
    {
      "id": "10",
      "title": "등수 간 동반 변동",
      "question": "한 등수가 많이 나온 회차에 다른 등수도 같이 움직이는가?",
      "formula": "자기 등수 강건점수 × 나머지 두 등수 강건점수 평균",
      "note": "양수는 같은 방향, 음수는 반대 방향이다. Spearman 상관계수도 저장하며 인과관계를 주장하지 않는다.",
      "normalization": "등수별 Z점수"
    },
    {
      "id": "11",
      "title": "과산포 보정의 시간 분리 검증",
      "question": "과거에 학습한 분산으로 이후 회차의 극단값을 설명할 수 있는가?",
      "formula": "(K − fitted μ) / sqrt(fitted μ + alpha × fitted μ²)",
      "note": "각 등수·기간의 앞 70%만 학습한다. 뒤 30%의 NB2 이중 꼬리확률을 전체 검증군에서 BY 보정한다. 모수 불확실성을 포함하지 않은 탐색적 후보다.",
      "normalization": "등수별 Z점수"
    },
    {
      "id": "12",
      "title": "한 회차의 세 등수 상세 비교",
      "question": "가장 큰 관측/기대 비율 회차에서는 세 등수가 함께 튀는가?",
      "formula": "전 회차 R의 등수별 Z점수로 사례 ±12회 비교",
      "note": "전체 자료에서 최고 비율 회차를 선택했다. 사후 선택 사례이므로 발견적 설명이며 선택 자체를 독립 검정으로 취급하지 않는다.",
      "normalization": "전체 회차 Z점수 참조"
    }
  ],
